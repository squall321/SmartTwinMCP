{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cuboid_scatter_drop_simulation args",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_dir", "lstc_license_ip"],
  "properties": {
    "work_dir": {"type": "string", "pattern": "^/.+", "description": "Absolute path to the job work directory. Scenario/runner_config/output land here."},
    "model_file": {"type": "string", "default": "MinimumModel.k", "description": "Model .k 파일 이름 (work_dir 안에 있어야 함). Default 'MinimumModel.k'."},
    "model_file_path": {"type": "string", "pattern": "^/.+\\.k$", "description": "Model .k 파일 절대경로. 지정 시 work_dir로 자동 복사."},
    "lstc_license_ip": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$", "description": "LSTC license server IPv4 address."},
    "tolerance_deg": {"type": "number", "default": 2.0, "minimum": 0.1, "maximum": 30, "description": "각 기준방향 주변 섭동 폭(± deg). roll/pitch/yaw 에 동일 적용. Default 2.0."},
    "doe_count": {"type": "integer", "default": 5, "minimum": 1, "maximum": 500, "description": "기준방향당 스캐터 샘플 수. 총 run = 기준방향수 × doe_count. Default 5."},
    "doe_type": {"type": "string", "enum": ["lhs", "full_factorial", "random"], "default": "lhs", "description": "섭동 샘플링 방식. lhs=라틴하이퍼큐브(권장), random=무작위, full_factorial=격자."},
    "include_faces": {"type": "boolean", "default": true, "description": "6개 면 방향 포함. Default true."},
    "include_edges": {"type": "boolean", "default": true, "description": "12개 엣지 방향 포함. Default true."},
    "include_corners": {"type": "boolean", "default": true, "description": "8개 코너 방향 포함. Default true."},
    "drop_height_mm": {"type": "number", "default": 1500, "minimum": 1, "maximum": 50000, "description": "낙하 높이 (mm). Default 1500."},
    "simulation_time_s": {"type": "number", "default": 0.005, "minimum": 1e-06, "maximum": 10, "description": "시뮬레이션 종료 시간 (초). Default 0.005."},
    "ncpu": {"type": "integer", "default": 2, "minimum": 1, "maximum": 64, "description": "잡당 CPU 수. Default 2."},
    "memory": {"type": "string", "default": "4G", "pattern": "^[0-9]+[GM]$", "description": "Slurm memory (e.g. '4G', '512M'). Default '4G'."},
    "time_limit": {"type": "string", "default": "12:00:00", "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$", "description": "Slurm walltime limit, HH:MM:SS. Default '12:00:00'."},
    "enable_postprocess": {"type": "boolean", "default": true, "description": "KooD3plotReader 자동 후처리 마스터 토글."},
    "auto_deep": {"type": "boolean", "default": true, "description": "enable_postprocess=true 시 deep_report 자동 실행 (각 시뮬마다)."},
    "auto_sphere": {"type": "boolean", "default": true, "description": "enable_postprocess=true 시 sphere_report dependent job 자동 제출. 이게 DynaForge report_scatter 입력이 된다."},
    "auto_deep_mode": {"type": "string", "enum": ["inline", "separate_job"], "default": "inline", "description": "inline=시뮬+deep 같은 Slurm Job. separate_job=시뮬 노드 즉시 해방."},
    "yield_stress_mpa": {"type": "number", "default": 350, "minimum": 1, "description": "재료 항복응력 (MPa). 후처리 임계값. Default 350."},
    "drop_surface_type": {"type": "string", "enum": ["Plane", "PlaneGraded", "RigidWall", "PlanewithRoughness"], "default": "Plane", "description": "낙하 표면 종류."},
    "sif_path_postprocessor": {"type": "string", "pattern": "^/.+\\.sif$", "description": "후처리 SIF 절대경로. default는 compute node /opt/apptainers/SmartTwinPostprocessor.sif."},
    "project_name": {"type": "string", "description": "프로젝트 라벨. 미지정 시 'Cuboid26_scatter_d<doe_count>' 자동."},
    "extra_scenario_overrides": {"type": "object", "description": "Tier 2 고급 옵션. scenario_full_reference 참조.", "additionalProperties": true},
    "sequential": {"type": "boolean", "default": false, "description": "Sequential mode: 노드당 1잡, 내부 순차 DOE."},
    "partition": {"type": "string", "description": "Slurm partition. 미지정 시 자동 선택. 'list'=탐색 모드."},
    "submit_cli_overrides": {"type": "object", "description": "Advanced. KooChainRun submit CLI flag override.", "additionalProperties": true},
    "dry_run": {"type": "boolean", "default": false, "description": "true면 scenario/runner_config만 생성하고 Slurm 제출 건너뜀."}
  }
}
